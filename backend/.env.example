# Copier ce fichier vers .env et renseigner les valeurs locales.
# Remplacer les valeurs entre chevrons par les paramètres de votre PostgreSQL.
DATABASE_URL=postgresql://<utilisateur>:<mot_de_passe>@postgres_server:5432/samafile

# Générer une clé longue et aléatoire, à conserver entre les redémarrages.
SECRET_KEY=<cle_secrete_aleatoire>
ACCESS_TOKEN_MINUTES=480

ADMIN_EMAIL=admin@exemple.sn
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=<mot_de_passe_admin>

# Démonstration uniquement : activer explicitement si nécessaire.
SEED_DEMO_ACCOUNTS=false
DEMO_PASSWORD=<mot_de_passe_demo>